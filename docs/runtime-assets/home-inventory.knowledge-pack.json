{
  "id": "home-inventory",
  "version": "0.3.0",
  "schema": {
    "fields": [
      { "key": "item_name", "type": "string", "required": true },
      {
        "key": "location",
        "type": "string",
        "required": true,
        "enum": {
          "options": ["药箱", "浴室柜", "厨房柜", "冰箱", "衣柜", "书柜", "抽屉", "储物箱", "车库", "其他"],
          "synonyms": {
            "医药箱": "药箱",
            "药品箱": "药箱",
            "卫生间柜": "浴室柜",
            "橱柜": "厨房柜",
            "厨柜": "厨房柜",
            "冷藏柜": "冰箱",
            "衣橱": "衣柜",
            "收纳箱": "储物箱"
          }
        }
      },
      { "key": "condition", "type": "string", "required": false },
      { "key": "quantity", "type": "string", "required": false },
      { "key": "brand", "type": "string", "required": false },
      { "key": "specification", "type": "string", "required": false },
      { "key": "expiry_date", "type": "string", "required": false },
      { "key": "category", "type": "string", "required": false },
      { "key": "owner_note", "type": "string", "required": false },
      { "key": "unit_price", "type": "string", "required": false }
    ]
  },
  "extractionRules": [
    "以每件或每组可辨识物品为单位输出一个独立 items 条目；每条保留关联照片编号，字段只描述该物品，禁止用“；”合并多件物品。",
    "位置、品牌、规格、品类、来源和有效期只从照片可见标签、照片说明、房间线索和用户指引中提取；位置必须匹配 location 枚举的规范标签或同义词，不能明确匹配时填写“待确认”，不得猜测。",
    "数量仅在可数或用户明确描述时填写；单价仅在价格标签、票据或用户说明明确时填写，未知则填写“待确认”，避免估算。",
    "有效期应保留标签中的原始日期表达；不要把生产日期、开封日期或保质期时长误写为有效期。",
    "摘要仅概括已识别的物品和待确认点，不得把完整照片说明或对话逐字转写到字段中。"
  ],
  "labels": {
    "template": "家庭物品盘点",
    "shotCount": "已记录照片",
    "summary": "盘点摘要",
    "item_name": "物品名称",
    "location": "存放位置",
    "condition": "物品状态",
    "quantity": "数量",
    "brand": "品牌",
    "specification": "规格",
    "expiry_date": "保质期/有效期",
    "category": "品类",
    "owner_note": "来源/备注",
    "unit_price": "单价"
  }
}

{
  "id": "crash-prep",
  "version": "0.2.0",
  "schema": {
    "fields": [
      { "key": "scene_location", "type": "string", "required": true },
      {
        "key": "vehicle_direction_position",
        "type": "string",
        "required": true,
        "enum": ["正前方", "正后方", "左前方", "右前方", "左侧", "右侧", "驾驶员侧", "副驾驶侧", "试验位中央", "试验位左侧", "试验位右侧", "待命区"],
        "synonyms": {
          "正前方": ["车头", "前方"],
          "正后方": ["车尾", "后方"],
          "左侧": ["左边"],
          "右侧": ["右边"],
          "驾驶员侧": ["主驾侧"],
          "副驾驶侧": ["副驾侧"]
        }
      },
      { "key": "safety_equipment", "type": "string", "required": true },
      { "key": "vehicle_condition", "type": "string", "required": false },
      { "key": "evidence_notes", "type": "string", "required": false }
    ]
  },
  "extractionRules": [
    "仅根据照片说明和可见证据提取；不可推测未出现的事实。",
    "安全设备、人员隔离和试验区域必须优先记录。",
    "车辆方向/位置必须从固定枚举中选择；证据未匹配时标记为待确认，不应编造。",
    "缺少证据的字段标记为待确认，不应编造。"
  ],
  "labels": {
    "template": "碰撞实验准备",
    "shotCount": "已记录照片",
    "summary": "现场摘要",
    "scene_location": "试验地点",
    "vehicle_direction_position": "车辆方向/位置",
    "safety_equipment": "安全设备",
    "vehicle_condition": "车辆状态",
    "evidence_notes": "证据说明"
  }
}

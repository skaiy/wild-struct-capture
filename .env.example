# 可选：原版 WAO 运行时中间件的服务端地址（不暴露给浏览器）。
# StructCapture BFF 仍拥有会话、整理结果和 HITL；WAO 只承载通用运行时资产/推理。
# 留空时，BFF 本地资产整理与浏览器 DevStub 仍可用于 POC。
# 若配置，WAO 应提供：${WAO_BASE_URL}/health
WAO_BASE_URL=
# 可选：原版 WAO 中 StructCapture organizer 的 UUID；留空时按名称
# structcapture-organizer 查询只读 Agent 目录。WAO 0.6 尚未提供可安全用于
# StructCapture 的 pack-aware Agent 调用面，因此该值不会把拍录数据发送给 WAO。
# 将来接入 WAO chat 时，BFF 必须从受信 OIDC 身份提供商取得短期 JWT；禁止在此
# 配置或共享 AGENTOS_JWT_SECRET，且不能用请求体或 X-Identity 伪造隔离 claims。
STRUCTCAPTURE_WAO_AGENT_ID=

# 可选：通用 OpenAI 兼容模型网关。可填写根地址或以 /v1 结尾的地址；
# BFF 会规范化为 /v1/chat/completions。未同时配置地址和 API key 时只走本地整理。
STRUCTCAPTURE_LLM_BASE_URL=
# 仅服务端读取的网关密钥；不要使用 NEXT_PUBLIC_ 前缀，也不要提交真实值。
STRUCTCAPTURE_LLM_API_KEY=
# 可选：模型和请求超时（毫秒）。默认 15000；远程网关建议 30000–60000，最大 60000。
STRUCTCAPTURE_LLM_MODEL=deepseek-v4-flash
STRUCTCAPTURE_LLM_TIMEOUT_MS=15000

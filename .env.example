# 可选：原版 WAO 运行时中间件的服务端地址（不暴露给浏览器）。
# StructCapture BFF 仍拥有会话、整理结果和 HITL；WAO 只承载通用运行时资产/推理。
# 留空时，BFF 本地资产整理与浏览器 DevStub 仍可用于 POC。
# 若配置，WAO 应提供：${WAO_BASE_URL}/health
WAO_BASE_URL=
# 可选：原版 WAO 中 StructCapture organizer 的 UUID；留空时按名称
# structcapture-organizer 查询只读 Agent 目录。目录中的 tenant/project 必须为
# structcapture/default，且必须与下方 IdP 签发 token 内的 claims 一致。
STRUCTCAPTURE_WAO_AGENT_ID=
# WAO Agent chat 的工作负载 OIDC client-credentials 配置。BFF 向 token endpoint
# 获取短期 access token，原样作为 Authorization: Bearer 转发给 WAO。
# Issuer/audience 必须与 WAO 的 AGENTOS_OIDC_ISSUER / AGENTOS_OIDC_AUDIENCE 完全相同；
# IdP 必须为此 client 签发 sub、tenant_id=structcapture、project_id=default、exp。
# 仅填 WAO_BASE_URL 不会发送拍录内容；缺任一项会安全地回退到模型网关/本地路径。
STRUCTCAPTURE_WAO_OIDC_TOKEN_URL=https://issuer.example.com/oauth/token
STRUCTCAPTURE_WAO_OIDC_CLIENT_ID=
# 只在服务端的部署密钥库设置，绝不使用 NEXT_PUBLIC_ 前缀或提交真实值。
STRUCTCAPTURE_WAO_OIDC_CLIENT_SECRET=
STRUCTCAPTURE_WAO_OIDC_ISSUER=https://issuer.example.com/
STRUCTCAPTURE_WAO_OIDC_AUDIENCE=wild-agentos
# 可选：IdP 要求的 OAuth scope；tenant/project 不从 scope 或请求体取得权威性。
STRUCTCAPTURE_WAO_OIDC_SCOPE=
# 仅当 WAO 配置的 vision model 能读取这些远程 HTTPS 图片 URL 时启用；默认只发文字证据。
# 已配置 WAO 时，Agent/OIDC/模型失败会直接返回 API 错误，不会降级到旁路模型或本地启发式。
STRUCTCAPTURE_WAO_INCLUDE_IMAGES=false
# 严禁配置、读取或共享 AGENTOS_JWT_SECRET；BFF 不自签 HS256 AgentOS token，
# 不使用 X-Identity，也不以请求体的 tenant/project 作为身份来源。

# 可选：通用 OpenAI 兼容模型网关。可填写根地址或以 /v1 结尾的地址；
# BFF 会规范化为 /v1/chat/completions。仅在未配置 WAO 时使用；配置后调用失败会返回 API 错误，
# 未同时配置地址和 API key 时才只走本地整理。
STRUCTCAPTURE_LLM_BASE_URL=
# 仅服务端读取的网关密钥；不要使用 NEXT_PUBLIC_ 前缀，也不要提交真实值。
STRUCTCAPTURE_LLM_API_KEY=
# 可选：模型超时（毫秒）。文字路径默认 25000；启用图片时默认 60000，
# 允许 20000–120000。VL 网关建议设置为 45000–60000 或更高。
STRUCTCAPTURE_LLM_MODEL=deepseek-v4-flash
STRUCTCAPTURE_LLM_TIMEOUT_MS=25000
# 仅在未配置 WAO 且网关明确支持图片 URL/data URL、模型为 VL 时启用；M0 演示可改为 true。
# 默认保持 false，只发送照片说明和拍摄指引。启用图片后，图片服务超时、413 或不可用会返回
# vision_* API 错误，不会静默降级为纯文本整理；可重试或关闭图片识别。
STRUCTCAPTURE_LLM_INCLUDE_IMAGES=false
# 图像输入的服务端上限。data URL 会缩放并转为 JPEG；远程 HTTPS URL 不会由 BFF 抓取。
STRUCTCAPTURE_VISION_MAX_SHOTS=4
STRUCTCAPTURE_VISION_MAX_EDGE_PX=1280
STRUCTCAPTURE_VISION_MAX_BYTES=700000

# 可选：原版 WAO 运行时中间件的服务端地址（不暴露给浏览器）。
# StructCapture BFF 仍拥有会话、整理结果和 HITL；WAO 只承载通用运行时资产/推理。
# 留空时，BFF 本地资产整理与浏览器 DevStub 仍可用于 POC。
# 若配置，WAO 应提供：${WAO_BASE_URL}/health
WAO_BASE_URL=

# 可选：用于通用 Agent chat 增强的 WAO Agent。默认对应
# docs/runtime-assets/structcapture.agent.json 中的 structcapture-organizer。
# 留空时使用该默认值；未安装 Agent、WAO 不健康或调用失败时仍走本地知识包整理。
WAO_STRUCTCAPTURE_AGENT_ID=structcapture-organizer

# 可选：WAO health/chat 请求超时（毫秒），范围 1–15000；默认 5000。
WAO_REQUEST_TIMEOUT_MS=5000
